# 主力 LLM（阿里云 DashScope）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash
# 同一个阿里云 Key 下的备用千问模型（逗号分隔，按顺序尝试）
# QWEN_FALLBACK_MODELS=qwen-flash-2025-07-28,qwen-plus

# 备选 LLM（智谱 GLM）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 备选 LLM（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 按任务指定首选模型（可选，逗号分隔按顺序尝试；不填则用内置默认列表）
# LLM_TASK_CHAT_MODELS=qwen3.5-flash,qwen3-max-preview
# LLM_TASK_TRANSLATE_MODELS=qwen-mt-flash,qwen-mt-plus
# LLM_TASK_SUMMARY_MODELS=qwen-flash-2025-07-28
# LLM_TASK_SEARCH_MODELS=
# LLM_TASK_CATEGORIZE_MODELS=
# LLM_TASK_ENRICH_MODELS=

# PubMed E-utilities 联系邮箱（NCBI 建议填写，便于其在异常时联系你）
# EMAIL=you@example.com

# 论文分类打分的并发线程数（可选，默认 4）
# CATEGORIZE_MAX_WORKERS=4

# 管理员设备 ID：从本地网站设置页复制 UUID，填入后重启后端。
# 留空时所有设备都无权修改/探测主机模型配置；普通阅读和 Zotero 连接仍可使用。
# 此 ID 相当于访问凭证，不得公开。管理员对部分端点不限速，并非成本上限。
OWNER_UID=

# 每日限速配置（可选，不填则使用默认值）
DAILY_RECOMMEND_LIMIT=5    # 每人每天获取推荐结果的批次数
DAILY_CHAT_LIMIT=60        # 对话 / 精读带读 / OCR / 卡片草稿共用；不含自测
DAILY_TRANSLATE_LIMIT=120  # 每人每天翻译次数
SELF_TEST_DAILY_LIMIT=300   # 自测单独计数
GLOBAL_DAILY_CHAT_LIMIT=500  # 仅覆盖接入此计数的对话类端点，并非所有 AI 调用的费用上限

# 所有模型尝试统一计数（含回退、后台分类、翻译、自测和 owner 探测）。UTC 零点重置。
# 这是请求次数上限，不是人民币金额；SDK 隐式重试已关闭。
GLOBAL_DAILY_AI_REQUEST_LIMIT=500
AI_MAX_CONCURRENT_REQUESTS=4
UPLOAD_TOTAL_LIMIT_MB=2048
UPLOAD_USER_LIMIT_MB=250

# 先用 scripts/manage_trial.py extend 为现有同事设备续期，再启用邀请制。
# false 保留现有试用模式；true 时只有未过期邀请和 owner 可访问业务 API。
PAPERMIND_INVITE_ONLY=false

# CORS 允许来源（有域名后填写，多个用逗号分隔；不填则允许所有来源）
# ALLOWED_ORIGINS=https://yourdomain.com

# Sentry 错误监控（可选）
# SENTRY_DSN=https://xxx@oyyy.ingest.us.sentry.io/zzz
